# TechD DSPM Configuration
DSPM_APP_NAME="TechD DSPM"
DSPM_DEBUG=false
DSPM_SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32

# Database
DSPM_DATABASE_URL=postgresql+asyncpg://dspm:dspm@localhost:5432/dspm

# Redis
DSPM_REDIS_URL=redis://localhost:6379/0
DSPM_CELERY_BROKER_URL=redis://localhost:6379/1
DSPM_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Elasticsearch
DSPM_ELASTICSEARCH_URL=http://localhost:9200

# Kafka
DSPM_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Encryption
DSPM_CREDENTIAL_ENCRYPTION_KEY=generate-with-python-cryptography-fernet

# Scanning
DSPM_MAX_SCAN_WORKERS=10
DSPM_SCAN_SAMPLE_SIZE=1000
DSPM_MAX_FILE_SIZE_MB=100

# CORS
DSPM_CORS_ORIGINS=["http://localhost:3000"]

# Logging
DSPM_LOG_LEVEL=INFO
