# TechD DSPM Configuration
DSPM_APP_NAME="TechD DSPM"
DSPM_DEBUG=false

# REQUIRED — Generate with: openssl rand -hex 32
DSPM_SECRET_KEY=

# REQUIRED — Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DSPM_CREDENTIAL_ENCRYPTION_KEY=

# Database (use a strong password in production)
DSPM_DATABASE_URL=postgresql+asyncpg://dspm:CHANGE_ME@localhost:5432/dspm

# Redis (use a password in production)
DSPM_REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
DSPM_CELERY_BROKER_URL=redis://:CHANGE_ME@localhost:6379/1
DSPM_CELERY_RESULT_BACKEND=redis://:CHANGE_ME@localhost:6379/2

# Elasticsearch (enable security in production)
DSPM_ELASTICSEARCH_URL=https://elastic:CHANGE_ME@localhost:9200

# Kafka
DSPM_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Scanning
DSPM_MAX_SCAN_WORKERS=10
DSPM_SCAN_SAMPLE_SIZE=1000
DSPM_MAX_FILE_SIZE_MB=100

# CORS — list of allowed frontend origins
DSPM_CORS_ORIGINS=["http://localhost:3000"]

# Logging
DSPM_LOG_LEVEL=INFO

# Public registration (set to true only if needed; new users get read_only role)
DSPM_ALLOW_PUBLIC_REGISTRATION=false
