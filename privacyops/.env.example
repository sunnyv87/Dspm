# ═══════════════════════════════════════════════════════════════════════
# TechD PrivacyOps — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════

# ─── Infrastructure ───────────────────────────────────────────────────
POSTGRES_PASSWORD=change_this_postgres_password
REDIS_PASSWORD=change_this_redis_password

# ─── Auth Service ─────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-hex-string

# ─── SMTP (Notification Service) ─────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourcompany.com

# ─── Slack Integration ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# ─── DSPM Integration ────────────────────────────────────────────────
# Points to existing DSPM platform (default: localhost:8000)
DSPM_API_URL=http://localhost:8000/api/v1
